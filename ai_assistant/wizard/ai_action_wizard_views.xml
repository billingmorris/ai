<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de líneas (inline) -->
    <record id="view_ai_wizard_line_tree" model="ir.ui.view">
        <field name="name">ai.wizard.line.tree</field>
        <field name="model">ai.wizard.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="product_id" options="{'no_create': False}"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="uom_id" options="{'no_create': True}"/>
                <field name="price_unit" widget="monetary"/>
            </tree>
        </field>
    </record>

    <!-- Vista principal del wizard -->
    <record id="view_ai_action_wizard_form" model="ir.ui.view">
        <field name="name">ai.action.wizard.form</field>
        <field name="model">ai.action.wizard</field>
        <field name="arch" type="xml">
            <form string="🤖 Asistente de IA">
                <sheet>
                    <!-- Campos ocultos requeridos por attrs -->
                    <field name="res_model"    invisible="1"/>
                    <field name="res_id"       invisible="1"/>
                    <field name="record_name"  invisible="1"/>
                    <field name="ai_response"  invisible="1"/>
                    <field name="show_lines"   invisible="1"/>
                    <field name="show_partner" invisible="1"/>
                    <field name="show_ref"     invisible="1"/>

                    <!-- Header -->
                    <div style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);
                        color:white;padding:16px 20px;border-radius:8px;margin-bottom:18px;">
                        <h2 style="margin:0;color:white;font-size:18px;">
                            🤖 Asistente de Inteligencia Artificial
                        </h2>
                        <p style="margin:4px 0 0;opacity:.85;font-size:12px;">
                            Selecciona la acción, el contacto, los productos y envía.
                        </p>
                    </div>

                    <!-- Fila 1: Acción + Proveedor IA -->
                    <group>
                        <group string="Configuración">
                            <field name="action_type" widget="radio"
                                style="column-count:2;"/>
                            <field name="provider_id"
                                options="{'no_create': True}"/>
                        </group>
                        <group string="Datos del documento"
                            attrs="{'invisible': [('show_partner','=',False)]}">
                            <field name="partner_id"
                                attrs="{'invisible': [('show_partner','=',False)],
                                        'required': [('show_partner','=',True),
                                                     ('action_type','not in',['query','send_email','draft_text'])]}"
                                options="{'no_create': False}"/>
                            <field name="date"
                                attrs="{'invisible': [('show_lines','=',False)]}"/>
                            <field name="ref"
                                attrs="{'invisible': [('show_ref','=',False)]}"/>
                        </group>
                    </group>

                    <!-- Líneas de productos -->
                    <group string="📦 Productos"
                        attrs="{'invisible': [('show_lines','=',False)]}">
                        <field name="line_ids" nolabel="1"
                            widget="one2many_list"
                            context="{'default_wizard_id': active_id}">
                            <tree editable="bottom">
                                <field name="product_id"
                                    options="{'no_create': False}"
                                    style="min-width:220px;"/>
                                <field name="name" optional="show"/>
                                <field name="quantity"/>
                                <field name="uom_id"
                                    options="{'no_create': True}"
                                    optional="show"/>
                                <field name="price_unit" widget="monetary"/>
                            </tree>
                        </field>
                    </group>

                    <!-- Prompt libre -->
                    <group string="💬 Instrucciones adicionales / Prompt">
                        <field name="user_input" nolabel="1" widget="text"
                            style="width:100%;min-height:80px;resize:vertical;"
                            placeholder="Ej: Aplica un descuento del 10% en todas las líneas. / ¿Cuánto facturamos este mes?"/>
                    </group>

                    <!-- Adjuntos -->
                    <group string="📎 Archivos adjuntos (PDF / imágenes)">
                        <field name="attachment_ids"
                            widget="many2many_binary"
                            nolabel="1"
                            options="{'accepted_file_extensions': '.pdf,.png,.jpg,.jpeg,.gif,.webp'}"/>
                    </group>

                    <!-- Botón principal -->
                    <div class="text-center" style="margin:16px 0;">
                        <button name="action_call_ai" type="object"
                            string="✨ Generar con IA"
                            class="btn-primary"
                            style="padding:10px 44px;font-size:15px;border-radius:6px;"/>
                    </div>

                    <!-- Error -->
                    <div class="alert alert-danger" role="alert"
                        attrs="{'invisible': [('error_message','=',False)]}">
                        <strong>❌ Error: </strong>
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </div>

                    <!-- Respuesta IA -->
                    <div attrs="{'invisible': [('ai_response','=',False)]}"
                        style="margin-top:12px;">
                        <div class="o_form_label"
                            style="font-weight:600;color:#444;margin-bottom:6px;">
                            📄 Respuesta de la IA
                        </div>
                        <field name="response_html" widget="html"
                            nolabel="1" readonly="1"/>
                    </div>
                </sheet>

                <footer attrs="{'invisible': [('ai_response','=',False)]}">
                    <button name="action_apply_response" type="object"
                        string="✅ Crear en Odoo"
                        class="btn-success"
                        confirm="¿Confirmas crear este documento en Odoo?"/>
                    <button name="action_call_ai" type="object"
                        string="🔄 Regenerar"
                        class="btn-secondary"/>
                    <button string="Cerrar" special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción standalone -->
    <record id="action_ai_assistant_standalone" model="ir.actions.act_window">
        <field name="name">🤖 Asistente IA</field>
        <field name="res_model">ai.action.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
