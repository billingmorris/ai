<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW -->
    <record id="view_ai_provider_form" model="ir.ui.view">
        <field name="name">ai.provider.form</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <form string="Proveedor de IA">
                <header>
                    <button name="action_test_connection" string="🔌 Probar Conexión"
                        type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" icon="fa-list"
                            name="action_view_logs"
                            attrs="{'invisible': [('total_requests', '=', 0)]}">
                            <field name="total_requests" widget="statinfo" string="Solicitudes"/>
                        </button>
                        <button class="oe_stat_button" type="object" icon="fa-database"
                            name="action_view_logs"
                            attrs="{'invisible': [('total_tokens', '=', 0)]}">
                            <field name="total_tokens" widget="statinfo" string="Tokens"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Por Defecto" bg_color="bg-success"
                        attrs="{'invisible': [('is_default', '=', False)]}"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del proveedor"/></h1>
                    </div>
                    <group>
                        <group string="Configuración del Proveedor">
                            <field name="provider_type"/>
                            <field name="api_key" password="True"/>
                            <field name="api_url"/>
                            <field name="model_name"/>
                            <field name="is_default"/>
                        </group>
                        <group string="Parámetros">
                            <field name="max_tokens"/>
                            <field name="temperature" widget="float"/>
                            <field name="timeout"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Estadísticas" attrs="{'invisible': [('total_requests', '=', 0)]}">
                        <group>
                            <field name="last_used" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>💡 Modelos recomendados:</strong><br/>
                        OpenAI: <code>gpt-4o</code>, <code>gpt-4o-mini</code><br/>
                        Anthropic: <code>claude-sonnet-4-6</code>, <code>claude-haiku-4-5-20251001</code><br/>
                        DeepSeek: <code>deepseek-chat</code>, <code>deepseek-reasoner</code>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_ai_provider_list" model="ir.ui.view">
        <field name="name">ai.provider.list</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <tree string="Proveedores de IA" decoration-success="is_default == True">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider_type"/>
                <field name="model_name"/>
                <field name="is_default"/>
                <field name="total_requests"/>
                <field name="last_used"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_ai_provider" model="ir.actions.act_window">
        <field name="name">Proveedores de IA</field>
        <field name="res_model">ai.provider</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
