<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="IA Assistant" string="IA Assistant"
                    data-key="ai_assistant">
                    <h2>Configuración de IA</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="ai_log_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ai_log_enabled"/>
                                <div class="text-muted">
                                    Registrar todas las llamadas al API de IA
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_default_provider_id" string="Proveedor por Defecto"/>
                                <field name="ai_default_provider_id"
                                    options="{'no_create': True}"/>
                                <div class="text-muted">
                                    Proveedor de IA que se usará por defecto en todo el sistema
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_max_tokens_global" string="Máx. Tokens Global"/>
                                <field name="ai_max_tokens_global"/>
                                <div class="text-muted">
                                    Límite global de tokens por solicitud (0 = sin límite)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16">
                        <div class="col-12">
                            <button name="action_open_ai_providers" type="object"
                                string="⚙️ Gestionar Proveedores de IA"
                                class="btn btn-secondary"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
