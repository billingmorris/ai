<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_log_form" model="ir.ui.view">
        <field name="name">ai.log.form</field>
        <field name="model">ai.log</field>
        <field name="arch" type="xml">
            <form string="Log de IA" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="provider_id"/>
                            <field name="model"/>
                            <field name="tokens_used"/>
                            <field name="status"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="action_type"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <group string="Prompt Enviado">
                        <field name="prompt" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <group string="Respuesta">
                        <field name="response" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <group string="Error" attrs="{'invisible': [('error_message', '=', False)]}">
                        <field name="error_message" nolabel="1" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_log_list" model="ir.ui.view">
        <field name="name">ai.log.list</field>
        <field name="model">ai.log</field>
        <field name="arch" type="xml">
            <tree string="Logs de IA" create="false" decoration-danger="status == 'error'">
                <field name="create_date"/>
                <field name="provider_id"/>
                <field name="model"/>
                <field name="action_type"/>
                <field name="tokens_used"/>
                <field name="status"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_ai_log_search" model="ir.ui.view">
        <field name="name">ai.log.search</field>
        <field name="model">ai.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="provider_id"/>
                <field name="user_id"/>
                <filter name="errors" string="Solo Errores" domain="[('status','=','error')]"/>
                <filter name="today" string="Hoy"
                    domain="[('create_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_provider" string="Proveedor" context="{'group_by': 'provider_id'}"/>
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_log" model="ir.actions.act_window">
        <field name="name">Logs de IA</field>
        <field name="res_model">ai.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
