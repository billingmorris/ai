<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_ai_creator_log_tree" model="ir.ui.view">
    <field name="name">ai.creator.log.tree</field>
    <field name="model">ai.creator.log</field>
    <field name="arch" type="xml">
        <tree create="false" decoration-danger="status=='error'"
              decoration-success="status=='success'">
            <field name="create_date"/>
            <field name="record_type"/>
            <field name="res_name"/>
            <field name="provider_id"/>
            <field name="status"/>
            <field name="user_id"/>
        </tree>
    </field>
</record>

<record id="view_ai_creator_log_form" model="ir.ui.view">
    <field name="name">ai.creator.log.form</field>
    <field name="model">ai.creator.log</field>
    <field name="arch" type="xml">
        <form create="false" edit="false">
            <sheet>
                <group>
                    <group>
                        <field name="create_date"/>
                        <field name="record_type"/>
                        <field name="res_name"/>
                        <field name="res_model"/>
                        <field name="provider_id"/>
                        <field name="status"/>
                        <field name="user_id"/>
                    </group>
                </group>
                <group string="Instrucción del usuario">
                    <field name="instruction" nolabel="1" readonly="1" widget="text"/>
                </group>
                <group string="JSON extraído">
                    <field name="json_result" nolabel="1" readonly="1" widget="text"
                        style="font-family:monospace;font-size:12px"/>
                </group>
                <group string="Error" attrs="{'invisible': [('error_msg','=',False)]}">
                    <field name="error_msg" nolabel="1" readonly="1" widget="text"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="view_ai_creator_log_search" model="ir.ui.view">
    <field name="name">ai.creator.log.search</field>
    <field name="model">ai.creator.log</field>
    <field name="arch" type="xml">
        <search>
            <field name="res_name"/>
            <filter name="errors"   string="Solo errores"  domain="[('status','=','error')]"/>
            <filter name="success"  string="Exitosos"      domain="[('status','=','success')]"/>
            <filter name="customer" string="Clientes"      domain="[('record_type','=','customer')]"/>
            <filter name="supplier" string="Proveedores"   domain="[('record_type','=','supplier')]"/>
            <filter name="product"  string="Productos"     domain="[('record_type','=','product')]"/>
            <group expand="0" string="Agrupar por">
                <filter name="g_type" string="Tipo"
                    context="{'group_by':'record_type'}"/>
                <filter name="g_user" string="Usuario"
                    context="{'group_by':'user_id'}"/>
                <filter name="g_date" string="Fecha"
                    context="{'group_by':'create_date:day'}"/>
            </group>
        </search>
    </field>
</record>

<record id="action_ai_creator_log" model="ir.actions.act_window">
    <field name="name">Historial de Creaciones</field>
    <field name="res_model">ai.creator.log</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'create': False}</field>
</record>

</odoo>
